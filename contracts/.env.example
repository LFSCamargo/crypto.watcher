# Copy to contracts/.env and fill in. Used by script/deploy-base-sepolia.sh.

# --- Networks ---
# Base Sepolia RPC (deploy target). e.g. https://sepolia.base.org or a provider URL.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Ethereum Sepolia RPC (only needed to run the fork integration tests).
SEPOLIA_RPC_URL=

# --- Deployer account ---
# Private key of the funded deployer account (Base Sepolia ETH from a faucet,
# e.g. https://www.alchemy.com/faucets/base-sepolia). 0x-prefixed.
# Create a fresh one with: cast wallet new
DEPLOYER_PRIVATE_KEY=

# --- Contract verification (optional) ---
# Basescan API key; when set the deploy script passes --verify.
BASESCAN_API_KEY=

# --- Deploy parameters (optional; sensible defaults in Deploy.s.sol) ---
# Platform backend allowed to emit project contracts (defaults to deployer).
BACKEND_SUBMITTER=
# INITIAL_SUPPLY (wei), VOTING_DURATION (seconds), TIMELOCK_MIN_DELAY (seconds),
# MIN_REPUTATION_WEIGHT.
INITIAL_SUPPLY=
VOTING_DURATION=
TIMELOCK_MIN_DELAY=
MIN_REPUTATION_WEIGHT=
