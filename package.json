{
  "name": "crypto-watcher",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "22.13.x"
  },
  "scripts": {
    "dev": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run-many -t dev --parallel=2 --projects=api,web",
    "build": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run-many -t build",
    "test": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run-many -t test",
    "test:coverage": "pnpm --filter api exec vitest run --coverage",
    "lint": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run-many -t lint",
    "typecheck": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run-many -t typecheck",
    "check:spaghetti": "node scripts/check-spaghetti.mjs",
    "knip": "knip",
    "check:knip": "knip",
    "knip:exports": "knip --exports",
    "o1-check": "node packages/o1-check/dist/cli.js",
    "o1-check:api": "pnpm --filter o1-check run build && node packages/o1-check/dist/cli.js apps/api/src --config o1-check.config.json --fail-below 50",
    "o1-check:web": "pnpm --filter o1-check run build && node packages/o1-check/dist/cli.js apps/web/src --config o1-check.web.config.json --fail-below 70",
    "lighthouse:web": "pnpm --filter web lighthouse",
    "email:dev": "pnpm --filter email-templates dev",
    "format": "prettier --write . && pnpm run format:contracts",
    "format:contracts": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run contracts:format",
    "deploy:testnet": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run contracts:deploy:testnet",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@eslint/js": "^9.5.0",
    "@nx/js": "19.8.4",
    "eslint": "^9.5.0",
    "husky": "^9.0.11",
    "knip": "^6.17.1",
    "nx": "19.8.4",
    "prettier": "^3.3.2",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
