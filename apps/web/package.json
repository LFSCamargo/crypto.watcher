{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "seo:generate": "tsx scripts/generate-seo-files.ts",
    "build": "tsx scripts/generate-seo-files.ts && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "lighthouse": "tsx scripts/run-lighthouse.ts",
    "lint": "eslint src e2e playwright.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json",
    "icons:sync": "node scripts/sync-crypto-icons.mjs",
    "icons:sync:force": "node scripts/sync-crypto-icons.mjs -- --force"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/raleway": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-navigation-menu": "^1.2.16",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@rainbow-me/rainbowkit": "^2.1.0",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-query": "^5.50.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.24.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^3.6.0",
    "viem": "^2.17.0",
    "wagmi": "^2.12.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.19",
    "chrome-launcher": "^1.2.1",
    "jsdom": "^24.1.0",
    "lighthouse": "^12.8.2",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.16.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  }
