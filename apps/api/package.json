{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node --import tsx src/main.ts",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/core/db/migrate.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "email-templates": "workspace:*",
    "kysely": "^0.27.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.12.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.0",
    "swagger-ui-express": "^5.0.1",
    "viem": "^2.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^2.1.9",
    "supertest": "^7.2.2",
    "tsx": "^4.16.0",
    "vitest": "^2.0.0"
  }
}
