{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node --import tsx src/main.ts",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/core/db/migrate.ts"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.1.0",
    "@sinclair/typebox": "^0.34.0",
    "elysia": "^1.1.0",
    "kysely": "^0.27.0",
    "pg": "^8.12.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.16.0",
    "vitest": "^2.0.0"
  }
}
