NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crypto_watcher
LOG_LEVEL=debug
# CORS allowed origins (comma-separated). Defaults to http://localhost:5173.
CORS_ORIGINS=http://localhost:5173
# SMTP (MailHog locally)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Crypto Watcher <noreply@localhost>"
WEB_URL=http://localhost:5173
# Chain — Base Sepolia testnet in non-production.
RPC_URL=https://sepolia.base.org
# Ethereum Sepolia RPC for contract fork integration tests (contracts/test/integration).
# When unset, those tests are skipped automatically.
SEPOLIA_RPC_URL=
