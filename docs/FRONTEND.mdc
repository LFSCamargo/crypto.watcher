## Client Data Model & Schemas

> API response types are generated from the backend OpenAPI schema and live in
> `lib/api/`. Form/input validation uses Zod with React Hook Form. Server-cache
> state is held by the data layer; UI/session state lives in Zustand (`store/`).

### Domain types (mirror backend, in `lib/api/types.ts`) `[MVP]`

```ts
export type ProjectState =
  | 'in_analysis' | 'under_review' | 'report_published'

export interface Project {
  id: string
  slug: string
  name: string
  description?: string
  chainId: number
  tokenAddress?: string
  state: ProjectState
  votingContractAddress?: string
  score?: number
  createdAt: string
}

export interface Comment {
  id: string; projectId: string; authorId: string
  body: string; createdAt: string
}

export interface Proposal {
  id: string; onchainId: string; proposerAddress: string; title: string
  description: string | null
  state: 'pending' | 'active' | 'succeeded' | 'defeated' | 'executed'
  startBlock: string | null
  endBlock: string | null
}

export interface Reputation {
  walletAddress: string; eligible: boolean; weight: string
  factors: Record<string, unknown> | null
}
```

### Form schemas (Zod + React Hook Form) `[MVP]`

```ts
// modules/projects/api/schemas.ts
export const createProjectSchema = z.object({
