{
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": [
    { "directory": "apps/api", "changeProcessCWD": true },
    { "directory": "apps/web", "changeProcessCWD": true }
  ],
  "solidity.packageDefaultDependenciesDirectory": "contracts/lib",
  "solidity.remappings": [
    "@openzeppelin/=contracts/lib/openzeppelin-contracts/",
    "forge-std/=contracts/lib/forge-std/src/"
  ],
  "solidity.compileUsingRemoteVersion": "v0.8.26",
  "wake.configuration.toml_path": "wake.toml",
  "wake.configuration.use_toml_if_present": true,
  "Tools-for-Solidity.wake.configuration.autoimport_remappings": false,
  "files.associations": {
    "*.mdc": "markdown"
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.nx": true,
    "contracts/lib": true,
    "contracts/out": true,
    "contracts/cache": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.nx/**": true,
    "contracts/lib/**": true,
    "contracts/out/**": true,
    "contracts/cache/**": true
  }
}
