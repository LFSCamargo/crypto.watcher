# =============================================================================
# Crypto Watcher — central environment file
# -----------------------------------------------------------------------------
# Copy to `.env` at the repo root (`cp .env.example .env`). This single file is
# shared by the API (apps/api), the web app (apps/web, VITE_* vars) and the
# contracts deploy/test scripts (contracts/). Real process env (Docker/CI) always
# overrides values defined here.
#
# Put machine-local secret overrides in `.env.local` (also git-ignored), which
# takes precedence over `.env`.
# =============================================================================

# --- Shared ------------------------------------------------------------------
NODE_ENV=development
# Production Docker Compose (docker-compose.yml) — required in prod:
# POSTGRES_USER=cw_app
# POSTGRES_PASSWORD=change-me-strong-password
# POSTGRES_DB=crypto_watcher
# WEB_PORT=8080   # only with docker-compose.local.yml for local smoke tests
# Public URL of the web app (used by the API for email links + logo).
WEB_URL=http://localhost:5173

# --- API (apps/api) ----------------------------------------------------------
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crypto_watcher
LOG_LEVEL=debug
# CORS allowed origins (comma-separated).
CORS_ORIGINS=http://localhost:5173
# SMTP (MailHog locally).
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="Crypto Watcher <noreply@localhost>"
# Chain RPC the API reads from (Base Sepolia testnet in non-production).
RPC_URL=https://sepolia.base.org

# --- Web (apps/web) — must be VITE_-prefixed to reach the browser ------------
# Dev: http://localhost:3000 (or leave unset with pnpm dev). Prod Docker/Coolify: leave empty → /api prefix.
VITE_API_URL=http://localhost:3000
# Public site URL for SEO (canonical links, sitemap, Open Graph). Production: https://your-domain.com
VITE_SITE_URL=http://localhost:5173
VITE_WALLETCONNECT_PROJECT_ID=
# Default chain for the app (Base Sepolia = 84532).
VITE_DEFAULT_CHAIN_ID=84532

# --- Contracts (contracts/) --------------------------------------------------
# Base Sepolia RPC (deploy target).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Ethereum Sepolia RPC (only needed for the fork integration tests; when unset
# those tests are skipped automatically). Also read by the API-less test suite.
SEPOLIA_RPC_URL=
# Funded deployer private key (0x-prefixed). Create one with `cast wallet new`.
DEPLOYER_PRIVATE_KEY=
# Basescan API key; when set the deploy script passes --verify.
BASESCAN_API_KEY=
# Platform backend allowed to emit project review contracts (defaults to deployer).
BACKEND_SUBMITTER=
# Optional deploy parameter overrides (sensible defaults live in Deploy.s.sol):
# INITIAL_SUPPLY (wei), TIMELOCK_MIN_DELAY (s), MIN_REPUTATION_WEIGHT,
# METHODOLOGY_VERSION, GOV_VOTING_DELAY (blocks), GOV_VOTING_PERIOD (blocks),
# GOV_PROPOSAL_THRESHOLD (wei), GOV_QUORUM_FRACTION (percent).
INITIAL_SUPPLY=
TIMELOCK_MIN_DELAY=
MIN_REPUTATION_WEIGHT=
METHODOLOGY_VERSION=
GOV_VOTING_DELAY=
GOV_VOTING_PERIOD=
GOV_PROPOSAL_THRESHOLD=
GOV_QUORUM_FRACTION=
